      "import": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "engines": {
    "node": ">=20.19.0"
  },
  "peerDependencies": {
    "vite": "^5.0.0 || ^6.0.0 || ^7.0.0",
    "@feathersjs/feathers": "^5.0.0",
    "@feathersjs/express": "^5.0.0",
    "@feathersjs/errors": "^5.0.0",
    "@feathersjs/koa": "^5.0.0",
    "@feathersjs/socketio": "^5.0.0"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "@koa/cors": "^5.0.0",
    "tinyglobby": "^0.2.17"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/express": "^4.17.21",
    "@feathersjs/express": "^5.0.50",
    "@feathersjs/feathers": "^5.0.50",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^5.0.5",
    "@types/cors": "^2.8.19",
    "@feathersjs/errors": "^5.0.50",
    "@feathersjs/koa": "^5.0.50",
    "@feathersjs/socketio": "^5.0.50",
    "@koa/cors": "^5.0.0",
    "socket.io-client": "^4.8.4"
