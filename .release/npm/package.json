{
  "name": "@vevedh/vite-plugin-feathersjs",
  "version": "0.2.6",
  "description": "FeathersJS v5 REST and Socket.IO services in Vite development, with Koa or Express and service HMR",
  "type": "module",
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
