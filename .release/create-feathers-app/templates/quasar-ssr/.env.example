# Do not copy production secrets here. HTTP API and edge listen on loopback.
# WARNING: the unmodified plugin 0.2.6 Socket.IO app.listen(port) may bind all interfaces.
# Use Socket.IO only on an isolated/firewalled lab until host binding is added.
FEATHERS_ADAPTER=koa
FEATHERS_SOCKETIO=0
FEATHERS_API_PORT=3030
FEATHERS_SOCKET_PORT=3031
FEATHERS_EDGE_PORT=8080
QUASAR_SSR_PORT=9100
FEATHERS_PUBLIC_ORIGIN=http://127.0.0.1:8080
VITE_FEATHERS_REALTIME=0
