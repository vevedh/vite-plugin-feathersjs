{
  "name": "@vevedh/vite-plugin-feathersjs",
  "version": "0.3.0",
  "description": "FeathersJS v5 REST and Socket.IO services in Vite development, with Koa or Express and service HMR",
  "type": "module",
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "engines": {
    "node": ">=20.19.0"
  },
  "peerDependencies": {
    "@feathersjs/errors": "^5.0.0",
    "@feathersjs/express": "^5.0.0",
    "@feathersjs/feathers": "^5.0.0",
    "@feathersjs/koa": "^5.0.0",
    "@feathersjs/socketio": "^5.0.0",
    "vite": "^5.0.0 || ^6.0.0 || ^7.0.0"
  },
  "dependencies": {
    "@koa/cors": "^5.0.0",
    "cors": "^2.8.6",
    "tinyglobby": "^0.2.17"
  },
  "devDependencies": {
    "@feathersjs/authentication": "5.0.50",
    "@feathersjs/errors": "5.0.50",
    "@feathersjs/express": "5.0.51",
    "@feathersjs/feathers": "5.0.50",
    "@feathersjs/koa": "5.0.51",
    "@feathersjs/socketio": "5.0.51",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/koa__cors": "^5.0.1",
    "@types/node": "^22.0.0",
    "socket.io-client": "^4.8.4",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^5.0.5"
  },
  "scripts": {
    "prepublishOnly": "node tools/release/npm-publish-guard.mjs",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build && npm run test:vitest && npm run test:node",
    "check": "npm run check:syntax && npm run typecheck && npm run test",
    "pack:dry": "npm run stage:npm && npm run test:npm:package && npm pack --ignore-scripts --dry-run ./.release/npm",
    "test:unit": "vitest run tests/options.test.ts tests/app.test.ts tests/hmr-utils.test.ts --maxWorkers=2 --no-file-parallelism",
    "test:integration": "vitest run tests/transport.integration.test.ts tests/vite-start-stop.integration.test.ts --maxWorkers=2 --no-file-parallelism",
    "check:fast": "npm run typecheck && npm run test:unit",
    "check:release": "npm run check && npm run check:docs && npm run pack:dry",
    "audit:runtime": "npm audit --omit=dev",
    "audit:all": "npm audit",
    "check:security": "npm run audit:runtime && npm run audit:all",
    "test:unit:quick": "vitest run tests/options.test.ts tests/app.test.ts tests/hmr-utils.test.ts --maxWorkers=2 --no-file-parallelism --no-isolate",
    "versions:check": "node scripts/check-versions.mjs",
    "versions:outdated": "npm outdated --all",
    "check:quick": "npm run typecheck && npm run test:unit:quick",
    "stage:npm": "node scripts/stage-npm-release.mjs",
    "test:npm:package": "node scripts/test-npm-release.mjs",
    "check:git-publication": "node scripts/check-git-publication.mjs",
    "test:integration:lifecycle": "vitest run tests/vite-start-stop.integration.test.ts --maxWorkers=2 --no-file-parallelism",
    "check:docs": "node scripts/check-documentation.mjs",
    "docs:dev": "npm --prefix docs run dev",
    "docs:build": "node scripts/check-vitepress-deps.mjs public && npm --prefix docs run build",
    "docs:preview": "npm --prefix docs run preview",
    "docs:setup": "corepack pnpm --dir docs install --frozen-lockfile",
    "test:vitest": "node scripts/test-vitest.mjs",
    "test:node": "node scripts/test-node-contracts.mjs",
    "check:syntax": "node scripts/check-typescript-syntax.mjs"
  },
  "private": true,
  "keywords": [
    "vite",
    "vite-plugin",
    "feathers",
    "feathersjs",
    "koa",
    "express",
    "socket.io",
    "typescript",
    "rest",
    "hmr"
  ]
}
