{
  "name": "vite-plugin-feathersjs",
  "version": "1.4.0",
  "description": "A vite plugin to run Feathers and other Node servers.",
  "type": "module",
  "scripts": {
    "build": "tsup && tsup --outDir=dist/styles 'src/styles/*.css'",
    "release": "npm publish --access public",
    "test": "npx tsc --noEmit"
  },
  "main": "dist/index.js",
  "types": "dist/",
  "exports": {
    ".": {
      "types": "dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles/*.css": {
      "default": "./dist/styles/*.css"
    }
  },
  "files": [
    "dist/"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://gitlab.com/vevedh/vite-plugin-feathersjs.git"
  },
  "keywords": [
    "feathersjs",
    "vite",
    "server",
    "real-time"
  ],
  "author": "Hervé de CHAVIGNY",
  "license": "ISC",
  "bugs": {
    "url": "https://gitlab.com/vevedh/vite-plugin-feathersjs/issues"
  },
  "homepage": "https://gitlab.com/vevedh/vite-plugin-feathersjs#readme",
  "devDependencies": {
    "@types/node": "^16.11.59",
    "autoprefixer": "^10.4.13",
    "postcss-nesting": "^10.2.0",
    "tsup": "^6.1.2",
    "typescript": "^4.8.4",
    "vite": "^4.2.0"
  },
  "peerDependencies": {
    "vite": "^4"
  },
  "tsup": {
    "target": "esnext",
    "clean": true,
    "entry": [
      "src/index.ts"
    ],
    "format": [
      "esm"
    ],
    "sourcemap": true,
    "dts": true
  },
  "postcss": {
    "map": false,
    "plugins": {
      "postcss-nesting": {},
      "autoprefixer": {}
    }
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "trailingComma": "none"
  }
}
