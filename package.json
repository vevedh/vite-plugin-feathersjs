{
  "name": "@vevedh/vite-plugin-feathersjs",
  "version": "0.2.7",
  "description": "FeathersJS v5 REST and Socket.IO services in Vite development, with Koa or Express and service HMR",
  "type": "module",
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "engines": {
    "node": ">=20.19.0"
  },
  "peerDependencies": {
    "@feathersjs/errors": "^5.0.0",
    "@feathersjs/express": "^5.0.0",
    "@feathersjs/feathers": "^5.0.0",
    "@feathersjs/koa": "^5.0.0",
    "@feathersjs/socketio": "^5.0.0",
    "vite": "^5.0.0 || ^6.0.0 || ^7.0.0"
  },
  "dependencies": {
    "@koa/cors": "^5.0.0",
    "cors": "^2.8.6",
    "tinyglobby": "^0.2.17"
  },
  "devDependencies": {
    "@feathersjs/authentication": "5.0.50",
    "@feathersjs/errors": "5.0.50",
    "@feathersjs/express": "5.0.51",
    "@feathersjs/feathers": "5.0.50",
    "@feathersjs/koa": "5.0.51",
    "@feathersjs/socketio": "5.0.51",
    "@koa/cors": "^5.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "socket.io-client": "^4.8.4",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^5.0.5"
  },
  "scripts": {
  "prepublishOnly": "node tools/release/npm-publish-guard.mjs",
    "clean": "node scripts/clean.mjs",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run test:vitest && npm run test:node",
    "check": "npm run typecheck && npm run test && npm run build",
    "pack:dry": "npm run stage:npm && npm run test:npm:package && npm pack --dry-run .release/npm",
    "test:unit": "vitest run tests/options.test.ts tests/app.test.ts tests/hmr-utils.test.ts --maxWorkers=2 --no-file-parallelism",
    "test:integration": "vitest run tests/transport.integration.test.ts tests/vite-start-stop.integration.test.ts --maxWorkers=2 --no-file-parallelism",
    "check:fast": "npm run typecheck && npm run test:unit",
    "check:release": "npm run check:r16-r5-r1 && npm run check:fast && npm run test:node && npm run test:integration && npm run build && npm run pack:dry",
    "audit:runtime": "npm audit --omit=dev",
    "audit:all": "npm audit",
    "check:security": "npm run audit:runtime && npm run audit:all",
    "test:unit:quick": "vitest run tests/options.test.ts tests/app.test.ts tests/hmr-utils.test.ts --maxWorkers=2 --no-file-parallelism --no-isolate",
    "versions:check": "node scripts/check-versions.mjs",
    "versions:outdated": "npm outdated --all",
    "check:quick": "npm run typecheck && npm run test:unit:quick",
    "check:r16-r5-r1": "node scripts/check-r16-r5-r1-regressions.mjs",
    "stage:npm": "node scripts/stage-npm-release.mjs",
    "test:npm:package": "node scripts/test-npm-release.mjs",
    "check:git-publication": "node scripts/check-git-publication.mjs",
    "clean:git-index": "node scripts/clean-git-index.mjs",
    "test:git-publication": "node --test tests/git-publication.test.mjs",
    "test:integration:lifecycle": "vitest run tests/vite-start-stop.integration.test.ts --maxWorkers=2 --no-file-parallelism",
    "check:docs": "node scripts/check-documentation.mjs && node --test tests/docs-structure.test.mjs",
    "docs:dev": "npm --prefix docs run dev",
    "docs:build": "node scripts/check-vitepress-deps.mjs public && npm --prefix docs run build",
    "docs:preview": "npm --prefix docs run preview",
    "docs:private:dev": "npm --prefix docs-private run dev",
    "docs:private:build": "node scripts/check-vitepress-deps.mjs private && npm --prefix docs-private run build",
    "docs:private:preview": "npm --prefix docs-private run preview",
    "docs:setup": "corepack pnpm --dir docs install --frozen-lockfile && corepack pnpm --dir docs-private install --frozen-lockfile",
    "docs:build:all": "npm run docs:setup && npm run check:docs && npm run docs:build && npm run docs:private:build && node scripts/check-documentation.mjs --built",
    "test:vitest": "vitest run --maxWorkers=2 --no-file-parallelism",
    "test:node": "node scripts/test-node-contracts.mjs",
    "test:pinia": "node --test tests/p3-r2-pinia.integration.test.mjs"
  },
  "private": false,
  "keywords": [
    "vite",
    "vite-plugin",
    "feathers",
    "feathersjs",
    "koa",
    "express",
    "socket.io",
    "typescript",
    "rest",
    "hmr"
  ]
}
