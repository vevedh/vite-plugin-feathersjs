{
  "name": "vite-plugin-feathersjs",
  "version": "0.2.4",
  "description": "Vite development plugin for FeathersJS v5: Koa or Express REST and optional Socket.IO",
  "type": "module",
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "engines": {
    "node": ">=20.19.0"
  },
  "peerDependencies": {
    "vite": "^5.0.0 || ^6.0.0 || ^7.0.0",
    "@feathersjs/feathers": "^5.0.0",
    "@feathersjs/express": "^5.0.0",
    "@feathersjs/errors": "^5.0.0",
    "@feathersjs/koa": "^5.0.0",
    "@feathersjs/socketio": "^5.0.0"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "@koa/cors": "^5.0.0",
    "tinyglobby": "^0.2.17"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/express": "^4.17.21",
    "@feathersjs/express": "^5.0.0",
    "@feathersjs/feathers": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^5.0.5",
    "@types/cors": "^2.8.17",
    "@feathersjs/errors": "^5.0.0",
    "@feathersjs/koa": "^5.0.0",
    "@feathersjs/socketio": "^5.0.0",
    "@koa/cors": "^5.0.0",
    "socket.io-client": "^4.8.1"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --maxWorkers=2 --no-file-parallelism",
    "check": "npm run typecheck && npm run test && npm run build",
    "pack:dry": "npm pack --dry-run",
    "test:unit": "vitest run tests/options.test.ts tests/app.test.ts --maxWorkers=2 --no-file-parallelism",
    "test:integration": "vitest run tests/transport.integration.test.ts --maxWorkers=2 --no-file-parallelism",
    "check:fast": "npm run typecheck && npm run test:unit",
    "check:release": "npm run check:fast && npm run test:integration && npm run build && npm run pack:dry",
    "audit:runtime": "npm audit --omit=dev",
    "audit:all": "npm audit",
    "check:security": "npm run audit:runtime && npm run audit:all"
  }
}
