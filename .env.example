# Development variables for vite-plugin-feathersjs
# Copy this file to `.env` and adjust values locally.
# Do NOT commit a real `.env` or any secret tokens.

# URL used by client apps to reach your Feathers server
# Example usage in clients: import.meta.env.VITE_FV_URL
VITE_FV_URL=http://localhost:8099

# Optional: developer identity surfaced to the plugin
# If unset, the plugin falls back to a default (e.g. 'vite')
VITE_FV_DEV_USER=vite

# Optional: turn off the server side generation helper in dev
# Uncomment to disable: 'off'
# VITE_FV_SSG=off

# CI publishing (example placeholder — do not put real tokens here)
# Prefer CI secrets + .npmrc over local .env for tokens
# NPM_TOKEN=YOUR_NPM_TOKEN

