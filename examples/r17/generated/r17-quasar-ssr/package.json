{
  "name": "r17-quasar-ssr",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.2",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev:ssr": "quasar dev -m ssr",
    "build:ssr": "quasar build -m ssr",
    "build": "quasar build -m ssr",
    "typecheck": "vue-tsc --noEmit",
    "dev:api": "node --env-file=.env.example api/server.mjs",
    "serve:production": "node dist/ssr/index.js",
    "postinstall": "quasar prepare",
    "dev:edge": "node scripts/edge-proxy.mjs",
    "dev:all": "node scripts/dev-all.mjs"
  },
  "dependencies": {
    "@vevedh/vite-plugin-feathersjs": "0.2.6",
    "@feathersjs/feathers": "^5.0.50",
    "@feathersjs/koa": "^5.0.50",
    "@feathersjs/express": "^5.0.50",
    "@feathersjs/errors": "^5.0.50",
    "@feathersjs/socketio": "^5.0.50",
    "@feathersjs/rest-client": "^5.0.50",
    "@feathersjs/socketio-client": "^5.0.50",
    "@quasar/extras": "^1.18.0",
    "pinia": "^3.0.4",
    "quasar": "^2.35.2",
    "socket.io-client": "^4.8.4",
    "vue": "^3.5.44",
    "vue-router": "^4.6.4",
    "express": "^4.22.3",
    "serialize-javascript": "^7.1.4",
    "@feathersjs/typebox": "^5.0.50",
    "ajv": "^8.17.1"
  },
  "devDependencies": {
    "@quasar/app-vite": "2.6.2",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.3",
    "vue-tsc": "^3.3.14",
    "@types/express": "4.17.25",
    "vite": "^7.3.7",
    "@types/express-serve-static-core": "4.19.9"
  },
  "pnpm": {
    "overrides": {
      "@types/express": "4.17.25",
      "@types/express-serve-static-core": "4.19.9"
    }
  }
}
