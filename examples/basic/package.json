{
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.30.2",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "build": "vite-ssg build",
    "dev": "vite --port 3333",
    "lint": "eslint .",
    "preview": "vite preview",
    "preview-https": "serve dist",
    "test": "vitest",
    "test:e2e": "cypress open",
    "test:unit": "vitest",
    "typecheck": "vue-tsc --noEmit",
    "up": "taze major -I",
    "postinstall": "npx simple-git-hooks",
    "sizecheck": "npx vite-bundle-visualizer",
    "test:feathers:contract": "node scripts/check-feathers-integration.mjs",
    "test:feathers:realtime-contract": "node scripts/check-feathers-realtime.mjs",
    "test:feathers:modes-contract": "node scripts/check-feathers-modes.mjs",
    "test:feathers:e2e": "node scripts/prepare-local-plugin.mjs && node scripts/check-release-e2e.mjs",
    "check:basic:release": "npm run test:feathers:agent-setup && npm run test:feathers:local-mcp && npm run test:feathers:local-resolution && npm run test:feathers:local-dist-sync && npm run prepare:feathers:local && npm run test:feathers:env && npm run test:feathers:r15r1-env-isolation && npm run test:feathers:project-plan && npm run test:feathers:r14-migration && npm run test:feathers:r14-structure && npm run test:feathers:r14-config-typing && npm run test:feathers:html-preload && npm run test:feathers:blueprints && npm run test:feathers:generator && npm run test:feathers:pinia-contract && npm run test:feathers:contract && npm run test:feathers:realtime-contract && npm run test:feathers:modes-contract && npm run test:feathers:r16-design && npm run typecheck && npm run test:feathers:e2e",
    "test:feathers:e2e:profile": "node scripts/check-basic-e2e.mjs",
    "check:basic:fast": "node scripts/check-feathers-integration.mjs && node scripts/check-feathers-realtime.mjs && node scripts/check-feathers-modes.mjs && vue-tsc --noEmit",
    "profile:r8": "node scripts/prepare-local-plugin.mjs && node scripts/check-r8-benchmark.mjs",
    "test:feathers:env": "node scripts/test-e2e-env.mjs",
    "prepare:feathers:local": "node scripts/prepare-local-plugin.mjs",
    "test:feathers:local-resolution": "node scripts/test-local-plugin-resolution.mjs",
    "test:feathers:local-dist-sync": "node scripts/test-local-dist-sync.mjs",
    "test:feathers:r9-contract": "node scripts/test-r9-analysis.mjs",
    "profile:r9:analyze": "node scripts/analyze-r9.mjs",
    "test:feathers:r10-contract": "node scripts/test-r10-contract.mjs",
    "test:feathers:pinia-contract": "node scripts/check-feathers-pinia.mjs",
    "check:basic:pinia": "npm run test:feathers:pinia-contract && npm run typecheck && npm run test:feathers:e2e",
    "test:feathers:blueprints": "node scripts/check-feathers-service-blueprints.mjs",
    "check:basic:blueprints": "npm run test:feathers:agent-setup && npm run test:feathers:project-plan && npm run test:feathers:r15r1-env-isolation && npm run test:feathers:local-mcp && npm run test:feathers:r14-migration && npm run test:feathers:r14-structure && npm run test:feathers:r14-config-typing && npm run test:feathers:html-preload && npm run test:feathers:blueprints && npm run test:feathers:generator && npm run test:feathers:pinia-contract && npm run test:feathers:r16-design && npm run typecheck",
    "generate:feathers:service": "node scripts/generate-feathers-service.mjs",
    "test:feathers:generator": "node scripts/test-feathers-generator.mjs",
    "test:feathers:agent-setup": "node scripts/test-vite-agent-setup.mjs",
    "dev:mcp": "node scripts/start-vite-mcp.mjs",
    "test:feathers:local-mcp": "node scripts/test-feathers-v5-mcp.mjs",
    "test:feathers:r14-structure": "node scripts/migrate-r14-legacy.mjs && node scripts/check-r14-structure.mjs",
    "test:feathers:html-preload": "node scripts/test-html-preload.mjs",
    "check:basic:r14-html-e2e": "node scripts/prepare-local-plugin.mjs && node scripts/check-r14-html-e2e.mjs",
    "profile:r14:analyze": "node scripts/analyze-r14.mjs",
    "check:basic:r14:fast": "npm run test:feathers:r14-migration && npm run test:feathers:r14-structure && npm run test:feathers:r14-config-typing && npm run test:feathers:html-preload && npm run test:feathers:generator && npm run test:feathers:blueprints && npm run test:feathers:pinia-contract && npm run typecheck",
    "prepare:feathers:migration": "node scripts/migrate-r14-legacy.mjs",
    "test:feathers:r14-migration": "node scripts/test-r14-migration.mjs",
    "test:feathers:r14-config-typing": "node scripts/test-r14-config-typing.mjs",
    "test:feathers:project-plan": "node scripts/test-feathers-project-plan.mjs",
    "plan:feathers:project": "node scripts/plan-feathers-project.mjs",
    "test:feathers:r15r1-env-isolation": "node scripts/test-r15-r1-env-isolation.mjs",
    "test:feathers:r16-design": "node scripts/test-r16-design-contract.mjs"
  },
  "dependencies": {
    "@unhead/vue": "catalog:frontend",
    "@unocss/reset": "catalog:frontend",
    "@vue/devtools-api": "catalog:frontend",
    "@vueuse/core": "catalog:frontend",
    "nprogress": "catalog:frontend",
    "pinia": "catalog:frontend",
    "vue": "catalog:frontend",
    "vue-i18n": "catalog:frontend",
    "vue-router": "catalog:frontend",
    "@feathersjs/feathers": "^5.0.50",
    "@feathersjs/rest-client": "^5.0.50",
    "@feathersjs/socketio-client": "^5.0.50",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:dev",
    "@iconify-json/carbon": "catalog:dev",
    "@intlify/unplugin-vue-i18n": "catalog:build",
    "@shikijs/markdown-exit": "catalog:build",
    "@types/markdown-it-link-attributes": "catalog:types",
    "@types/nprogress": "catalog:types",
    "@unocss/eslint-config": "catalog:build",
    "@vitejs/plugin-vue": "catalog:build",
    "@vue-macros/volar": "catalog:dev",
    "@vue/test-utils": "catalog:dev",
    "beasties": "catalog:build",
    "cypress": "catalog:dev",
    "cypress-vite": "catalog:dev",
    "eslint": "catalog:dev",
    "eslint-plugin-cypress": "catalog:dev",
    "eslint-plugin-format": "catalog:dev",
    "https-localhost": "catalog:dev",
    "jsdom": "catalog:dev",
    "lint-staged": "catalog:dev",
    "markdown-it-link-attributes": "catalog:build",
    "rollup": "catalog:build",
    "shiki": "catalog:build",
    "simple-git-hooks": "catalog:dev",
    "taze": "catalog:dev",
    "typescript": "catalog:dev",
    "unocss": "catalog:build",
    "unplugin-auto-import": "catalog:build",
    "unplugin-vue-components": "catalog:build",
    "unplugin-vue-markdown": "catalog:build",
    "vite": "catalog:build",
    "vite-bundle-visualizer": "catalog:build",
    "vite-plugin-inspect": "catalog:build",
    "vite-plugin-pwa": "catalog:build",
    "vite-plugin-vue-devtools": "catalog:build",
    "vite-plugin-vue-layouts": "catalog:build",
    "vite-ssg": "catalog:build",
    "vite-ssg-sitemap": "catalog:build",
    "vitest": "catalog:dev",
    "vue-macros": "catalog:build",
    "vue-tsc": "catalog:dev",
    "workbox-build": "catalog:build",
    "workbox-window": "catalog:build",
    "vite-plugin-feathersjs": "file:../..",
    "@feathersjs/koa": "^5.0.50",
    "@feathersjs/express": "^5.0.50",
    "@feathersjs/socketio": "^5.0.50",
    "@feathersjs/errors": "^5.0.50",
    "vite-plugin-mcp": "0.3.2"
  },
  "resolutions": {
    "@typescript-eslint/typescript-estree": "catalog:dev",
    "unplugin": "catalog:build",
    "vite": "catalog:build",
    "vite-plugin-inspect": "catalog:build"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*": "eslint --fix"
  },
  "name": "vite-plugin-feathersjs-example-vitesse"
}
