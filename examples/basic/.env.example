# Copy to .env.local for local-only development; no credentials belong in this file.
# Defaults retain full Vitesse functionality and native Vite chunk modulepreload.
FEATHERS_FAST_DEV=0
FEATHERS_DEV_WARMUP=0
VITE_HTML_PRELOAD=off
# Used only with VITE_HTML_PRELOAD=assets. Examples MUST be real files under public/.
# VITE_HTML_PRELOAD_ASSETS=/images/hero.webp,/fonts/ui.woff2
VITE_HTML_PRELOAD_ASSETS=
